# =============================================================================
# Peerzle Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# -----------------------------------------------------------------------------
# Client Build (Vite)
# -----------------------------------------------------------------------------
# For local development:
VITE_API_URL=http://localhost:3001
# For production (same-origin deployment): set to empty string
# VITE_API_URL=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peerzle

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Claude AI (Anthropic)
# Required for: PeerBot, safety monitoring, conversation suggestions
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# CORS - Client URL
# Required for: API and WebSocket CORS configuration
# -----------------------------------------------------------------------------
# For local development:
CLIENT_URL=http://localhost:5173
# For production (Railway): use your deployed URL
# CLIENT_URL=https://your-app.railway.app

# -----------------------------------------------------------------------------
# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@peerzle.com

# -----------------------------------------------------------------------------
# Email (Optional - uses Ethereal test service by default in development)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=noreply@peerzle.com
